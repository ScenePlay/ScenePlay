{
    // Two virtualenvs live side by side because the repo sits on a drive shared
    // between Linux and Windows: .venv (Linux) and .venv-win (Windows). The
    // "linux"/"windows" blocks pick the matching interpreter.
    //
    // F5 = the first configuration: the real app on :8086 with the forked
    // workers, integrations and cron ON (OBS / relay / LED remotes / WLED and
    // the cron wizard all act for real: this PC is the appliance now). The "UI
    // only" config exists for frontend work with uvicorn --reload; it never
    // starts mpv or dials OBS/relay (the player bar shows a "Players OFF" badge,
    // the terminal prints a banner, and the Enable buttons say why).
    // Both use the real database (<repo>/ScenePlay.db — no SP_DB_PATH). Only
    // one instance can own :8086, so both hand off with the deployed appliance
    // through tasks.json: preLaunchTask stops the copy started at login,
    // postDebugTask starts it again when the session ends. subProcess:false
    // everywhere — debugpy's child auto-attach breaks `python -m yt_dlp` on 3.14.
    // debugAdapterPython/debugLauncherPython are set explicitly next to "python":
    // when the interpreter the Python extension has *selected* is unusable on
    // this OS (the other platform's venv on the shared drive), the debugpy
    // extension resolves it to "" and that empty string wins over "python" for
    // the adapter/launcher — F5 then dies without any error message.

    "version": "0.2.0",
    "configurations": [
        {
            "name": "ScenePlay (F5): run the app \u2014 players ON, :8086",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ws.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "subProcess": false,
            "preLaunchTask": "sceneplay: stop deployed instance",
            "postDebugTask": "sceneplay: restart deployed instance",
            "env": {
                "SP_INTEGRATIONS": "1",
                "SP_CRON_APPLY": "1"
            },
            "windows": {
                "python": "${workspaceFolder}/.venv-win/Scripts/python.exe",
                "debugAdapterPython": "${workspaceFolder}/.venv-win/Scripts/python.exe",
                "debugLauncherPython": "${workspaceFolder}/.venv-win/Scripts/python.exe"
            },
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python",
                "debugAdapterPython": "${workspaceFolder}/.venv/bin/python",
                "debugLauncherPython": "${workspaceFolder}/.venv/bin/python"
            }
        },
        {
            "name": "ScenePlay: UI only, auto-reload (ws.py --dev) \u2014 players OFF",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/ws.py",
            "args": [
                "--dev"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "subProcess": false,
            "preLaunchTask": "sceneplay: stop deployed instance",
            "postDebugTask": "sceneplay: restart deployed instance",
            "env": {
                "SP_PORT": "8086",
                "SP_INTEGRATIONS": "0",
                "SP_CRON_APPLY": "0",
                "SP_MPV_SOCKET_PREFIX": "/tmp/mpvsocket-dev-"
            },
            "windows": {
                "python": "${workspaceFolder}/.venv-win/Scripts/python.exe",
                "debugAdapterPython": "${workspaceFolder}/.venv-win/Scripts/python.exe",
                "debugLauncherPython": "${workspaceFolder}/.venv-win/Scripts/python.exe"
            },
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python",
                "debugAdapterPython": "${workspaceFolder}/.venv/bin/python",
                "debugLauncherPython": "${workspaceFolder}/.venv/bin/python"
            }
        },
        {
            "name": "ScenePlay: pytest (whole suite)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests",
                "-q",
                "-p",
                "no:warnings"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "windows": {
                "python": "${workspaceFolder}/.venv-win/Scripts/python.exe",
                "debugAdapterPython": "${workspaceFolder}/.venv-win/Scripts/python.exe",
                "debugLauncherPython": "${workspaceFolder}/.venv-win/Scripts/python.exe"
            },
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python",
                "debugAdapterPython": "${workspaceFolder}/.venv/bin/python",
                "debugLauncherPython": "${workspaceFolder}/.venv/bin/python"
            }
        },
        {
            "name": "ScenePlay: pytest (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-q",
                "-p",
                "no:warnings"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "windows": {
                "python": "${workspaceFolder}/.venv-win/Scripts/python.exe",
                "debugAdapterPython": "${workspaceFolder}/.venv-win/Scripts/python.exe",
                "debugLauncherPython": "${workspaceFolder}/.venv-win/Scripts/python.exe"
            },
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python",
                "debugAdapterPython": "${workspaceFolder}/.venv/bin/python",
                "debugLauncherPython": "${workspaceFolder}/.venv/bin/python"
            }
        }
    ]
}
