{
    // Hand-off between the deployed appliance and the debugger. Only one
    // instance can own :8086 (core/boot.py refuses a second one), so F5 first
    // stops the copy started at login (~/ScenePlay/startApp.sh on Linux,
    // startApp.bat via the "ScenePlay" logon task on Windows) and, when the
    // debug session ends, starts it again. The bracket in 'ScenePlay/[w]s.py'
    // keeps pkill from matching the task's own shell; on Windows the filter
    // is python.exe + ws.py for the same reason (a command-line-text match
    // also hits the task's own powershell and kills it). The Windows commands
    // run straight in PowerShell (options.shell below): a nested
    // `powershell -Command "..."` gets its $_ expanded by the outer shell,
    // and backslash paths get mangled, so keep forward slashes.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "sceneplay: stop deployed instance",
            "type": "shell",
            "command": "pkill -TERM -f 'ScenePlay/[w]s.py' 2>/dev/null; for i in $(seq 1 30); do ss -ltn | grep -q ':8086 ' || { echo 'port 8086 free'; exit 0; }; sleep 0.5; done; echo 'port 8086 still busy'; exit 1",
            "windows": {
                "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"] } },
                "command": "Get-CimInstance Win32_Process | Where-Object { $_.Name -like 'python*' -and $_.CommandLine -like '*ws.py*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; foreach ($i in 1..30) { if (-not (Get-NetTCPConnection -LocalPort 8086 -State Listen -ErrorAction SilentlyContinue)) { Write-Host 'port 8086 free'; exit 0 }; Start-Sleep -Milliseconds 500 }; Write-Host 'port 8086 still busy'; exit 1"
            },
            "presentation": { "reveal": "silent", "close": true },
            "problemMatcher": []
        },
        {
            "label": "sceneplay: restart deployed instance",
            "type": "shell",
            "command": "if [ -x ~/ScenePlay/startApp.sh ]; then for i in $(seq 1 20); do ss -ltn | grep -q ':8086 ' || break; sleep 0.5; done; setsid nohup ~/ScenePlay/startApp.sh >> \"${workspaceFolder}/sceneplay_launch.log\" 2>&1 < /dev/null & disown; echo 'deployed instance restarting'; else echo 'no deployed instance here (~/ScenePlay/startApp.sh missing)'; fi",
            "windows": {
                "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"] } },
                "command": "if (-not (Get-ScheduledTask -TaskName ScenePlay -ErrorAction SilentlyContinue)) { Write-Host 'no deployed instance here (Task Scheduler task ScenePlay missing)'; exit 0 }; foreach ($i in 1..20) { if (-not (Get-NetTCPConnection -LocalPort 8086 -State Listen -ErrorAction SilentlyContinue)) { break }; Start-Sleep -Milliseconds 500 }; Start-Process -FilePath '${workspaceFolder}/startApp.bat' -WorkingDirectory '${workspaceFolder}' -WindowStyle Minimized; Write-Host 'deployed instance restarting'"
            },
            "presentation": { "reveal": "silent", "close": true },
            "problemMatcher": []
        }
    ]
}
